proc sql;
    title "Recon groups";
    select PRODUCT_TYPE label = "Product type",
           RECON_GRP    label = "Group",
           count(*)     label = "Posting accounts"
      from sasfiles.tb_mapping
     group by PRODUCT_TYPE, RECON_GRP
     order by PRODUCT_TYPE, RECON_GRP;
quit;
